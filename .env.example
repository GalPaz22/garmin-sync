# Server
PORT=3001
NODE_ENV=production

# MongoDB — the same cluster the main processing service uses.
# Required: the service refuses to start without it.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# AI enrichment (same keys as the main service)
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_AI_API_KEY=your-google-ai-key

# The store this service updates, as it is named in users.users
GARMIN_STORE=garmin

# Optional: when set, the API requires this token (x-sync-token header or
# ?token= on the URL). Leave unset to keep the button open to anyone with
# the link.
# SYNC_TOKEN=

# Twice-daily schedule for the Garmin sync
GARMIN_CRON_SCHEDULE=0 2,14 * * *
GARMIN_CRON_TIMEZONE=UTC

# Extra browser origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=https://yourdomain.com

# Optional concurrency tuning
PROCESS_CONCURRENCY=6
VARIATION_CONCURRENCY=10
IMG_CONCURRENCY=8
